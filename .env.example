# OpenConvo configuration.
# Copy to .env and adjust. Never commit .env — it contains secrets.

# ---------------------------------------------------------------------------
# Required

# Password for the bundled PostgreSQL container (docker compose). Compose
# refuses to start while this is empty, so a copied-but-unedited file fails
# closed instead of running on a password published in this repository. The
# interactive installer generates one; manual installs pick their own.
POSTGRES_PASSWORD=

# Password for the built-in OpenConvo administrator login. Required to
# serve the archive; use at least 12 characters. Compose refuses to start
# while it is empty, like the database password above: a container that boots
# and then restarts forever is a worse way to discover a missing setting.
OPENCONVO_ADMIN_PASSWORD=

# Exact released image to run. The guided installer writes this value, and
# scripts/upgrade.sh changes it after pulling and backing up a newer release.
OPENCONVO_IMAGE=ghcr.io/openconvo/openconvo:0.1.1

# ---------------------------------------------------------------------------
# Discord
# Create an application + bot at https://discord.com/developers/applications
# and enable the privileged "Message Content" intent. Keep the token secret:
# Discord's developer terms require credentials to stay confidential.

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# ---------------------------------------------------------------------------
# Server
#
# Under docker compose the container always listens on 8080 inside its own
# network namespace, and the first two settings decide where that is published
# on the host. A bare-process install has no published port: it ignores
# OPENCONVO_PUBLISH_ADDRESS and listens on OPENCONVO_HOST:OPENCONVO_PORT
# itself.

# Host port to publish (docker compose) / listen port (bare process).
OPENCONVO_PORT=8080

# Interface that port is published on (docker compose only). The safe default
# is loopback: only this machine and a local TLS reverse proxy can connect.
# Setting 0.0.0.0 exposes the administrator login over plaintext HTTP unless
# something outside Docker terminates TLS first. Docker's own iptables rules
# are consulted before ufw, so a host firewall alone is not a reliable guard.
# OPENCONVO_PUBLISH_ADDRESS=127.0.0.1

# Interface the HTTP server binds to; empty (the default) means every
# interface. A bare-process install behind a reverse proxy on the same
# machine should set 127.0.0.1 so nothing else on the network reaches
# OpenConvo directly. Leave it empty under docker compose: the container has
# its own network namespace, and binding to loopback there makes the published
# port unreachable — OpenConvo warns at startup if it finds this set that way.
# OPENCONVO_HOST=

# ---------------------------------------------------------------------------
# Database

# Connection string. Only needed when running OUTSIDE docker compose (compose
# builds it from POSTGRES_PASSWORD):
# DATABASE_URL=postgres://openconvo:password@localhost:5432/openconvo?sslmode=disable

# Apply schema migrations automatically on startup (default: true). Set it to
# false to hold migrations back before a risky upgrade and apply them
# yourself with "openconvo migrate"; docker compose forwards this setting.
# OPENCONVO_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Attachment storage

STORAGE_DRIVER=filesystem
STORAGE_PATH=/data/attachments

# Download the files attached to archived messages (default: false).
# Off by default because it is an open-ended disk commitment: a busy
# server's history can run to many gigabytes. Nothing is lost by
# enabling it later — attachment metadata is recorded either way, and
# OpenConvo can still fetch files whose Discord links have expired.
# OPENCONVO_ATTACHMENTS_ENABLED=false

# Largest single file to download, in bytes (default: 104857600, 100 MiB).
# OPENCONVO_ATTACHMENT_MAX_BYTES=104857600

# S3-compatible storage (AWS S3, Cloudflare R2, DigitalOcean Spaces,
# MinIO, and similar services). The bucket must already exist. See
# docs/self-hosting.md for provider examples and migration warnings.
# STORAGE_DRIVER=s3
# Leave S3_ENDPOINT empty for AWS S3. Set the provider's HTTPS API
# endpoint for compatible services.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional for temporary AWS or R2 credentials:
# S3_SESSION_TOKEN=
# Needed by MinIO and other providers that do not support virtual-hosted
# bucket addressing (default: false):
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Database backups
#
# Destination and cadence can be changed from the Backups page. These are the
# initial defaults until administrator settings are saved. Access credentials are
# ALWAYS read from the environment and are never stored in PostgreSQL.

# BACKUP_ENABLED=false
# BACKUP_PROVIDER=r2
# For R2: https://<account-id>.r2.cloudflarestorage.com
# Leave empty for Amazon S3.
# BACKUP_S3_ENDPOINT=
# R2 requires auto. Use the provider region for S3, B2, or custom storage.
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=openconvo/database-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# Optional temporary credential token:
# BACKUP_S3_SESSION_TOKEN=
# Usually needed only by MinIO-like custom endpoints:
# BACKUP_S3_FORCE_PATH_STYLE=false
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_COUNT=30
# Bare-process installs can override the pg_dump executable:
# BACKUP_PG_DUMP_PATH=pg_dump

# ---------------------------------------------------------------------------
# Optional message embeddings
#
# Enabling sends every non-empty, non-deleted archived message to OpenAI and
# builds a disposable semantic index. OPENAI_API_KEY is always environment-only.
# The dashboard opt-in overrides the initial enabled default.
# OPENCONVO_EMBEDDINGS_ENABLED=false
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Remote MCP search
#
# Exposes the read-only search_messages tool at /mcp on OpenConvo's existing
# HTTP listener. Keep this off unless the endpoint is served through HTTPS.
# Generate a dedicated credential with: openssl rand -hex 32
# OPENCONVO_MCP_HTTP_ENABLED=false
# OPENCONVO_MCP_TOKEN=

# ---------------------------------------------------------------------------
# Logging

# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
